{
  "name": "@sevenapps/vision-kit",
  "version": "0.1.0",
  "description": "On-device OCR, offline translation and face detection. Apple Vision/Translation on iOS, Google ML Kit on Android.",
  "license": "MIT",
  "author": "SevenApps",
  "repository": "https://github.com/sevenappsco/react-native-vision-kit",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./text": {
      "types": "./build/text/index.d.ts",
      "react-native": "./src/text/index.ts",
      "default": "./build/text/index.js"
    },
    "./translate": {
      "types": "./build/translate/index.d.ts",
      "react-native": "./src/translate/index.ts",
      "default": "./build/translate/index.js"
    },
    "./face": {
      "types": "./build/face/index.d.ts",
      "react-native": "./src/face/index.ts",
      "default": "./build/face/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android/build.gradle",
    "android/src",
    "expo-module.config.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": ["react-native", "expo", "ocr", "translation", "face-detection", "vision"],
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
